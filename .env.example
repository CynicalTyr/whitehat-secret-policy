# Names only. Copy to .env for *your* private scanner. Never commit .env.
#
# This package does not read these. They document the policy knobs your
# hunter should honor. Empty values mean "use your code defaults."
#
# AGENT_HUNTER_DETECT_ONLY=
# AGENT_HUNTER_ENTROPY_MIN=
# AGENT_HUNTER_CONTEXT_WINDOW=
# AGENT_HUNTER_MAX_VALIDATIONS_PER_RUN=
# AGENT_HUNTER_VALIDATION_SLEEP_SEC=
#
# Optional throwaway dir if you pair this gate with a review-envelope outbox:
# AGENT_HOME=/tmp/whitehat-secret-policy-demo
#
# Do not add a Slack webhook URL here. Validated keys go to a local human
# file; candidates stay masked. Never auto-disclose.
